# SOJIF Consulting - Environment Variables
# Copy this file to .env.local and fill in the values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo SMTP (admin form notifications only)
# Must match the Brevo SMTP sender configured for support@sojifconsulting.com.
# Use the SMTP relay login and SMTP key from Brevo, not the Supabase-hidden saved password.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Brevo API (legacy optional; Supabase Auth emails should stay handled by Supabase SMTP)
BREVO_API_KEY=

# Resend (Optional alternative email provider)
RESEND_API_KEY=

# Flutterwave (Payments)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Sentry (Monitoring)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Google Analytics
NEXT_PUBLIC_GA_ID=

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SOJIF Consulting
NODE_ENV=development
